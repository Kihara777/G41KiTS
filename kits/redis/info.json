{
  "name": "Redis",
  "desc": "Redis config store + Node.js HTTP API bridge",
  "depends": [
    "core",
    "nginx"
  ],
  "docker": [
    {"service": "redis", "container": "rd"},
    {"service": "api", "container": "ra"}
  ],
  "compose": "file",
  "provides": [
    {"dir": ".rd/data", "accepts": ["data"], "content": true, "file": "data", "check": false}
  ],
  "selftest": "G41_FS_SELFTEST=1 node store/server.js",
  "version": "1.0.0",
  "store": {
    "dir": ".rd",
    "items": {
      "server.js": "hardlink",
      "data": {
        "method": "mkdir"
      }
    }
  }
}
